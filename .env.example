# ============================================================
# STYLORA ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and provide your actual secrets.
# ============================================================

# Django Security Key
# In production, generate a cryptographically strong random string (>= 50 chars).
SECRET_KEY=django-insecure-change-this-in-production

# Debug Mode: True for local development, False for production
DEBUG=True

# Database Configuration
# Leave blank for local SQLite (db.sqlite3)
# For production (PostgreSQL), provide the connection URL:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Render Hosting
# Automatically provided by Render in production; leave blank for local dev:
RENDER_EXTERNAL_HOSTNAME=

# Supabase Storage & Auth
# Supabase project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=

# Backend Service Role Key (NEVER expose to frontend or commit to version control)
# Used for backend storage bucket operations and elevated API calls.
SUPABASE_SERVICE_ROLE_KEY=
